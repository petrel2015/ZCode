# 独立版本：无需平台登录。模型 Key、Base URL 和模型 ID 在「设置 → 模型设置」配置。
# GLM Coding Plan 的 Anthropic 兼容地址：https://open.bigmodel.cn/api/anthropic
# 不要把真实 Key 提交到仓库。

# 可选：本地内置 Provider 配置，缺省使用随源码发布的 config/provider/zcode-builtin.json。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=
# 可选：应用数据根目录，数据写入其下的 .zcode/。
ZCODE_DATA_BASE_DIR=
# 可选：自行托管的远程运行时资源；无默认下载服务。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=
# 可选：CLI 发行包的自托管下载根地址。
ZCODE_DIST_BASE_URL=
# 可选：私有构建依赖源。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
